{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "zenflow",
  "compatibility_date": "2026-07-21",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
