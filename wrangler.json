{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "zenflow",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-21",
  "keep_vars": true,
  "vars": {
    "APP_ORIGIN": "https://zenflow.com.tw",
    "FIREBASE_PROJECT_ID": "project-09054e85-fe75-4f73-a3d",
    "FIREBASE_DATABASE_ID": "ai-studio-ab68fdae-75a1-4c4e-b55e-fc65b5115e63"
  },
  "secrets": {
    "required": [
      "LINE_LOGIN_CHANNEL_ID",
      "LINE_LOGIN_CHANNEL_SECRET",
      "SESSION_SIGNING_SECRET",
      "LINE_CHANNEL_ACCESS_TOKEN",
      "LINE_CHANNEL_SECRET",
      "INTERNAL_WEBHOOK_SECRET",
      "FIREBASE_CLIENT_EMAIL",
      "FIREBASE_PRIVATE_KEY",
      "LINE_PAY_CHANNEL_ID",
      "LINE_PAY_CHANNEL_SECRET"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
